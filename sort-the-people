class Solution:
    def sortPeople(self, names: list[str], heights: list[int]) -> list[str]:
        n = len(heights)
        for i in range(n-1):
            max = heights[i]
            ind = i
            for j in range(i,n-1):
                if max < heights[j+1]:
                    max = heights[j+1]
                    ind = j + 1
            heights[i], heights[ind] = heights[ind], heights[i]
            names[i], names[ind] = names[ind], names[i]
        return names
