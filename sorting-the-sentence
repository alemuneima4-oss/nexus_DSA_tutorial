class Solution(object):
    def sortSentence(self, s):
        """
        :type s: str
        :rtype: str
        """
        words = s.split()
        result = [""]*len(words)
        for word in words:
            n = int(word[-1])
            p = n-1
            w = word[:-1]
            result[p] = w
        return " ".join(result)
        
