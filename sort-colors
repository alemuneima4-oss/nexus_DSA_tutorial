class Solution:
    def sortPeople(self, names: list[str], heights: list[int]) -> list[str]:
        n = len(heights)
        for i in range(n-1):
            for j in range(1,n):
                if heights[j-1] < heights[j]:
                    heights[j-1], heights[j] =heights[j], heights[j-1]
                    names[j-1], names[j] =names[j], names[j-1]
        return names
        
