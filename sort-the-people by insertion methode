class Solution:
    def sortPeople(self, names: list[str], heights: list[int]) -> list[str]:
        k = 1
        n = len(heights)
        for i in range(n-1):
            for j in range(1,k+1):
                if heights[k-j+1] > heights[k-j]:
                    heights[k-j+1],heights[k-j] = heights[k-j],heights[k-j+1]
                    names[k-j+1],names[k-j] = names[k-j],names[k-j+1]
            k += 1
        return names
