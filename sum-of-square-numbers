class Solution:
    def judgeSquareSum(self, c: int) -> bool:
        k = 0
        n = int(c**0.5)
        while k <= n:
            if k**2 + n**2 == c:
                return True
            elif k**2 + n**2 > c:
                n -= 1
            elif k**2 + n**2 < c:
                k += 1
        return False
        
