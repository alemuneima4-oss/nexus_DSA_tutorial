class Solution:
    def removeDuplicates(self, nums: list[int]) -> int:
        n = 0
        m = 1
        k = len(nums)
        for i in range(len(nums)-1):
            if nums[n] == nums[m]:
                nums.remove(nums[m])
                k -= 1
            else:
                m += 1
                n += 1
        print(k, nums)
