class Solution:
    def merge(self, nums1: list[int], m: int, nums2: list[int], n: int) -> None:
        """
        Do not return anything, modify nums1 in-place instead.
        """
        p1 = 0
        p2 = 0
        nums12 = []
        for i in range(m+n):
            if p2 < n and p1 < m and nums1[p1] >= nums2[p2]:
                nums12.append(nums2[p2])
                p2 += 1
            elif p1 < m and p2 < n and nums1[p1] < nums2[p2]:
                nums12.append(nums1[p1])
                p1 += 1
            elif p1 == m and p2 < n:
                nums12.append(nums2[p2])
                p2 += 1
            elif p2 == n and p1 < m:
                nums12.append(nums1[p1])
                p1 += 1
        nums1[:] = nums12
        return nums1
